# SME Finance Copilot — environment settings
# Copy this file to .env and fill in the values. Never commit .env.
# Lines marked [YOU] need a value from an outside service.
# Lines marked [LOCAL] are random secrets for our own services; generate them once.

# ── App ───────────────────────────────────────────────
APP_ENV=development
APP_BASE_URL=http://localhost:5173
API_BASE_URL=http://localhost:8000
# Public HTTPS address for incoming notifications. Not used in development:
# QuickBooks changes are polled (Change Data Capture) and Stripe events arrive via `stripe listen`.
PUBLIC_WEBHOOK_BASE_URL=

# [LOCAL] Signs session cookies
SESSION_SECRET=
# [LOCAL] 32-byte key (base64) that encrypts the personal-detail store
PII_VAULT_KEY=
# [LOCAL] 32-byte key (base64) that encrypts saved connection tokens (Plaid, QuickBooks)
TOKEN_ENCRYPTION_KEY=
# [LOCAL] Key for the tamper-evident activity log fingerprints
AUDIT_LOG_HMAC_KEY=

# ── AI (OpenRouter) ───────────────────────────────────
# [YOU] openrouter.ai → Keys. Attach the "fintechathon-2026" guardrail to this key.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Exact model IDs; must match the guardrail's model allowlist (we set these when building)
AI_MODEL_PRIMARY=
AI_MODEL_SECOND_OPINION=
# Our own cap, in addition to the guardrail budget
AI_DAILY_BUDGET_USD=10

# ── Payment platform (Stripe sandbox, UK) ─────────────
# [YOU] Stripe Dashboard → account picker → Switch to sandbox → Create sandbox →
#       "Create an account from scratch", then in that sandbox Settings → Business →
#       Account details → country United Kingdom (so everything is in GBP).
# [YOU] Restricted key (rk_test_…) from that sandbox: Read on Balance, Balance transactions,
#       Charges, Customers, Disputes, Events, Invoices, PaymentIntents, Payouts, Refunds.
#       Everything else None. The app only ever reads.
STRIPE_API_KEY=
# [YOU] That sandbox's secret key (sk_test_…), used only by the demo-data script
#       (uv run python -m app.demo.payments) and to forward notifications (app.demo.stripe_listen)
STRIPE_SEED_KEY=
# Written for you by: cd backend && uv run python -m app.demo.stripe_listen --save-secret
STRIPE_WEBHOOK_SECRET=
# [YOU] Optional. A second restricted key (rk_test_…) from the same sandbox, used only to make card
#       payment links for approved payment reminders: Write on Products, Prices and Payment Links.
#       Everything else None. Leave empty and reminders go out without a link.
STRIPE_LINKS_KEY=

# ── Bank (Plaid Sandbox) ──────────────────────────────
# [YOU] dashboard.plaid.com → Developers → Keys (the Sandbox secret, never Production)
#       "Connect" on the bank card creates a test link at Plaid's UK test bank, filled with the story's
#       six months of transactions. Nothing else to set up in the Plaid dashboard.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
PLAID_PRODUCTS=transactions
PLAID_COUNTRY_CODES=GB
# [LOCAL] We have no public address, so Plaid can't notify us; the API reads each bank on this schedule
BANK_POLL_MINUTES=15

# ── Accounting software (QuickBooks Online sandbox) ───
# [YOU] developer.intuit.com → your app → Development keys. Also add a UK sandbox company
#       (Dashboard → Sandbox → Add, country United Kingdom) so amounts are in pounds.
#       Connect it from the Connections page (or open /connect/quickbooks/start while signed in
#       as the owner), then fill it with the demo books: cd backend && uv run python -m app.demo.books
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_ENVIRONMENT=sandbox
QBO_SCOPES=com.intuit.quickbooks.accounting
# Must also be added as a redirect URI in the Intuit app settings
QBO_REDIRECT_URI=http://localhost:8000/connect/quickbooks/callback
# [YOU] Intuit app → Webhooks → Verifier token (only used when there is a public address)
QBO_WEBHOOK_VERIFIER_TOKEN=
# [LOCAL] Without a public address the API reads QuickBooks' change feed on this schedule
BOOKS_POLL_MINUTES=10

# ── Email inbox (Mailpit, runs in Docker) ─────────────
MAILPIT_API_URL=http://localhost:8025
MAILPIT_SMTP_HOST=localhost
MAILPIT_SMTP_PORT=1025
BILLS_INBOX_ADDRESS=bills@demo-business.test
# The name our receiving mail server signs its sender-check verdict with; any other verdict is ignored
MAIL_AUTHSERV_ID=mx.copilot.test

# ── Database (Postgres, runs in Docker) ───────────────
POSTGRES_DB=copilot
POSTGRES_USER=copilot
# [LOCAL]
POSTGRES_PASSWORD=
DATABASE_URL=postgresql+psycopg://copilot:${POSTGRES_PASSWORD}@localhost:5432/copilot
# Separate database account that alone can read the personal-detail store
VAULT_DB_USER=pii_vault
# [LOCAL]
VAULT_DB_PASSWORD=

# ── File archive (S3-compatible: SeaweedFS, runs in Docker) ──
ARCHIVE_S3_ENDPOINT=http://localhost:8333
ARCHIVE_S3_ACCESS_KEY=copilot-admin
# [LOCAL]
ARCHIVE_S3_SECRET_KEY=
ARCHIVE_BUCKET=evidence

# Runtime database account (no admin rights, row-level security applies)
APP_DB_USER=copilot_app
# [LOCAL]
APP_DB_PASSWORD=
# [LOCAL] 32-byte key (base64) that encrypts original documents before they reach the archive
ARCHIVE_ENCRYPTION_KEY=
