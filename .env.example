# SME Finance Copilot — environment settings
# Copy this file to .env and fill in the values. Never commit .env.
# Lines marked [YOU] need a value from an outside service.
# Lines marked [LOCAL] are random secrets for our own services; generate them once.

# ── App ───────────────────────────────────────────────
APP_ENV=development
APP_BASE_URL=http://localhost:5173
API_BASE_URL=http://localhost:8000
# Public HTTPS address for incoming notifications. Not used in development:
# QuickBooks changes are polled (Change Data Capture) and Stripe events arrive via `stripe listen`.
PUBLIC_WEBHOOK_BASE_URL=

# [LOCAL] Signs session cookies
SESSION_SECRET=
# [LOCAL] 32-byte key (base64) that encrypts the personal-detail store
PII_VAULT_KEY=
# [LOCAL] 32-byte key (base64) that encrypts saved connection tokens (Plaid, QuickBooks)
TOKEN_ENCRYPTION_KEY=
# [LOCAL] Key for the tamper-evident activity log fingerprints
AUDIT_LOG_HMAC_KEY=

# ── AI (OpenRouter) ───────────────────────────────────
# [YOU] openrouter.ai → Keys. Attach the "fintechathon-2026" guardrail to this key.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Exact model IDs; must match the guardrail's model allowlist (we set these when building)
AI_MODEL_PRIMARY=
AI_MODEL_SECOND_OPINION=
# Our own cap, in addition to the guardrail budget
AI_DAILY_BUDGET_USD=10

# ── Payment platform (Stripe, test mode / sandbox) ────
# [YOU] Restricted key (rk_test_…): Read on Balance, Balance transactions, Charges,
#       Customers, Events, Invoices, PaymentIntents, Payouts. Everything else None.
STRIPE_API_KEY=
# [YOU] Key used once by the demo-data script (sk_test_… or a restricted key with
#       Write on Customers, Invoices, Invoice items, PaymentIntents, Products, Prices)
STRIPE_SEED_KEY=
# [YOU] whsec_… printed by `stripe listen --forward-to localhost:8000/webhooks/stripe`
STRIPE_WEBHOOK_SECRET=

# ── Bank (Plaid Sandbox) ──────────────────────────────
# [YOU] dashboard.plaid.com → Developers → Keys
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
PLAID_PRODUCTS=transactions
PLAID_COUNTRY_CODES=GB

# ── Accounting software (QuickBooks Online sandbox) ───
# [YOU] developer.intuit.com → your app → Development keys
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_ENVIRONMENT=sandbox
QBO_SCOPES=com.intuit.quickbooks.accounting
# Must also be added as a redirect URI in the Intuit app settings
QBO_REDIRECT_URI=http://localhost:8000/connect/quickbooks/callback
# [YOU] Intuit app → Webhooks → Verifier token
QBO_WEBHOOK_VERIFIER_TOKEN=

# ── Email inbox (Mailpit, runs in Docker) ─────────────
MAILPIT_API_URL=http://localhost:8025
MAILPIT_SMTP_HOST=localhost
MAILPIT_SMTP_PORT=1025
# Mailpit calls this the moment an email arrives
MP_WEBHOOK_URL=http://api:8000/webhooks/mailpit
BILLS_INBOX_ADDRESS=bills@demo-business.test

# ── Database (Postgres, runs in Docker) ───────────────
POSTGRES_DB=copilot
POSTGRES_USER=copilot
# [LOCAL]
POSTGRES_PASSWORD=
DATABASE_URL=postgresql+psycopg://copilot:${POSTGRES_PASSWORD}@localhost:5432/copilot
# Separate database account that alone can read the personal-detail store
VAULT_DB_USER=pii_vault
# [LOCAL]
VAULT_DB_PASSWORD=

# ── File archive (S3-compatible: SeaweedFS, runs in Docker) ──
ARCHIVE_S3_ENDPOINT=http://localhost:8333
ARCHIVE_S3_ACCESS_KEY=copilot-admin
# [LOCAL]
ARCHIVE_S3_SECRET_KEY=
ARCHIVE_BUCKET=evidence

# Runtime database account (no admin rights, row-level security applies)
APP_DB_USER=copilot_app
# [LOCAL]
APP_DB_PASSWORD=
# [LOCAL] 32-byte key (base64) that encrypts original documents before they reach the archive
ARCHIVE_ENCRYPTION_KEY=
